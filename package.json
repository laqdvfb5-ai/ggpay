{
  "name": "ezpay-receiver",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && node scripts/copy-migrations.mjs",
    "start": "node dist/src/server.js",
    "migrate": "tsx src/db/migrate.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": { "dotenv": "^16.4.5", "express": "^5.0.1", "pg": "^8.13.1" },
  "devDependencies": {
    "@types/express": "^5.0.0", "@types/node": "^22.10.0", "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.3", "supertest": "^7.0.0", "tsx": "^4.19.2",
    "typescript": "^5.7.2", "vitest": "^2.1.8"
  }
}
